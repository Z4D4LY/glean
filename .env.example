# AI Web Scraper Configuration
# Copy this file to .env and customize for your setup.

# --- Option A: Local Ollama (default) ---
API_BASE_URL=http://localhost:11434/v1
MODEL=qwen2.5:14b
API_KEY=ollama

# --- Option B: Antemeta hosted Qwen ---
# API_BASE_URL=https://bcl.models.antemeta.ai/qwen3.5-122b-a10b-gptq-int4/v1
# MODEL=qwen3.5-122b-a10b
# API_KEY=no-key-required

# Generation settings
TEMPERATURE=0.6

# Where scraped results are saved
SAVE_DIR=~/.ai-web-scraper/scraped

# Scraping settings
REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=1000000